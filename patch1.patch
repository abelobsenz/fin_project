+            "val": dict(zip(["mean_pnl", "std_pnl", "objective"], eval_fixed_ratio(r0, val_idx))) if val_idx.size else None,
+        }
+
+    # Final learned evaluation.
+    model.eval()
+    with torch.no_grad():
