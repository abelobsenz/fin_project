+                            "val_objective": float(_pnl_objective(va, float(cfg.risk_aversion)).cpu()),
+                        }
+                    )
+                history.append(rec)
+
+    # Baselines.
+    baselines = {}
+    for name, r0 in {"ratio_0.0": 0.0, "ratio_0.85": 0.85, "ratio_1.0": 1.0}.items():
+        baselines[name] = {
